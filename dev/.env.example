# Copy to .env at the repo root (next to docker-compose.yml), fill in what you need, then:
#   docker compose up -d
# Leave unused variables empty. Never commit .env.

# =====================================================================================================
# LLM for nao: set at least one provider. You can also add / switch providers later in nao's Settings.
# =====================================================================================================

# --- Anthropic / OpenAI (nao picks one of these as the default model) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Amazon Bedrock ---
# Use ONE of the options below. They are passed to nao only (as AWS_REGION, AWS_ACCESS_KEY_ID, ...), so they
# never mix with the S3 credentials further down. Bedrock models then appear in nao's model picker; select one
# there (e.g. "Claude Sonnet 4.6 (Bedrock US)"). The region decides the cross-region inference prefix
# (us. / eu. / apac.), and the model must be enabled for your account in that region.
BEDROCK_AWS_REGION=us-east-1

# Option 1: Bedrock API key (Bedrock console -> API keys).
AWS_BEARER_TOKEN_BEDROCK=

# Option 2: IAM access keys with bedrock:InvokeModel / bedrock:InvokeModelWithResponseStream.
# For temporary credentials (SSO / assumed role), also set the session token. To copy them from a profile:
#   aws configure export-credentials --profile <profile> --format env
BEDROCK_AWS_ACCESS_KEY_ID=
BEDROCK_AWS_SECRET_ACCESS_KEY=
BEDROCK_AWS_SESSION_TOKEN=

# Option 3: a named profile from your ~/.aws (including SSO). Also uncomment the ~/.aws volume of the
# `nao` service in docker-compose.yml. With SSO, run `aws sso login --profile <profile>` on the host first.
BEDROCK_AWS_PROFILE=

# =====================================================================================================
# Data in AWS S3 for hudi-mcp. Only needed for tables you add in dev/hudi-mcp.yaml (see the examples there);
# the sample tables live in RustFS and don't use these.
# The identity needs s3:ListBucket on the buckets and s3:GetObject on the table prefixes.
# =====================================================================================================
LAKE_AWS_REGION=us-east-1
LAKE_AWS_ACCESS_KEY_ID=
LAKE_AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials. They expire: refresh them here and run `docker compose up -d hudi-mcp`.
LAKE_AWS_SESSION_TOKEN=

# =====================================================================================================
# Optional overrides for the local stack
# =====================================================================================================
# BETTER_AUTH_SECRET=some-random-string-of-at-least-20-chars
# RUSTFS_ACCESS_KEY=rustfsadmin
# RUSTFS_SECRET_KEY=rustfsadmin
# SEED_FORCE=1     # re-upload the sample tables on the next `up`
