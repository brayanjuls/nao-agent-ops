{
  "mcpServers": {
    "hudi": {
      "command": "hudi-mcp",
      "args": ["--config", "/app/hudi/config.yaml"],
      "env": {
        "AWS_REGION": "${AWS_REGION}",
        "AWS_ACCESS_KEY_ID": "${AWS_ACCESS_KEY_ID}",
        "AWS_SECRET_ACCESS_KEY": "${AWS_SECRET_ACCESS_KEY}"
      },
      "disabled": false,
      "autoApprove": [],
      "disabledTools": []
    }
  }
}
